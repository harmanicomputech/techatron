APP_NAME="Techatron Consulting"
# "staging" keeps search engines out (robots.txt disallow + noindex).
# Change to "production" when this replaces the live site.
APP_ENV=staging
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://techatronagency.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=warning

# SQLite file inside techatron_app/database (already created and migrated).
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Enquiries are always saved to the database. Until SMTP is set up, the
# notification email is written to storage/logs instead of being sent.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@techatronagency.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_INBOX=hello@techatronagency.com
