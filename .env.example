APP_NAME="Techatron Consulting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://techatronagency.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@techatronagency.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Site content (config/site.php) ---
# Contact details and social links default to Techatron's published details.
# Set a value here only to override it.
CONTACT_INBOX=
CONTACT_EMAIL=
# Comma-separated, local format, e.g. 09022016978,07045414419
CONTACT_PHONES=
CONTACT_WHATSAPP=
CONTACT_ADDRESS=
CONTACT_CITY=
CONTACT_COUNTRY=
CONTACT_COUNTRY_CODE=
# e.g. "within one business day" (leave blank to make no promise)
CONTACT_RESPONSE_TIME=
SITE_FOUNDED=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
